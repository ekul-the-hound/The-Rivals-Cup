# Copy to .env (never commit .env). Secrets live ONLY here.
APP_ENV=development            # development | production
APP_VERSION=0.1.0
DISPLAY_TIMEZONE=America/Chicago

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-side only. Used by ingestion jobs / dev-token mode. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# auth.users id of the single owner (see docs/supabase_setup.md). Required outside dev-token mode.
OWNER_USER_ID=

# DEVELOPMENT ONLY. Static bearer token that bypasses Supabase Auth and uses the service role.
# Refused at startup when APP_ENV=production. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
DEV_BEARER_TOKEN=

# Intentionally absent: no brokerage, Wall Street Rivals, Trader View, or Telegram credentials.

# --- Free data stack (see docs/data_providers.md) ---
# SEC requires a declared user agent with contact info: "Your Name your@email.com"
SEC_USER_AGENT=
FRED_API_KEY=
# Optional UA for Yahoo/Google News/Wikipedia (defaults to SEC_USER_AGENT)
WEB_USER_AGENT=
PROVIDER_CACHE_DIR=.cache/providers
# ESTIMATE only: assumed max leg size as a fraction of 20-day average dollar volume
WSR_EST_ADV_PCT_CAP=0.01
DEFAULT_LEG_SIZE_USD=10000

# --- MCP server (app/mcp). See docs/mcp_security.md ---
# Exact public HTTPS URL you paste into Claude Web (required in production)
MCP_PUBLIC_URL=
# OAuth authorization server issuer (defaults to {SUPABASE_URL}/auth/v1)
MCP_OAUTH_ISSUER=
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_MAX_RESPONSE_BYTES=80000
# DEVELOPMENT ONLY static bearer token for the local test client / MCP Inspector (>= 32 chars).
# Refused at startup when APP_ENV=production. Claude Web cannot use this; it uses OAuth.
MCP_DEV_BEARER_TOKEN=
# Production needs only SUPABASE_URL, SUPABASE_ANON_KEY and OWNER_USER_ID. The service-role key is NOT used
# by the MCP server in production (it is only read in development-token mode).

# --- Local dashboard (these two are read from your SHELL environment, NOT from .env) ---
# Set them per command, e.g.:  DASHBOARD_MODE=supabase python -m streamlit run app/dashboard/main.py
# DASHBOARD_MODE=mock            # mock (default, offline synthetic) | supabase (your project, local use only)
# MCP_AUDIT_LOG_FILE=logs/mcp_audit.log   # file the dashboard's MCP page reads audit lines from

# --- Target-sector universe (docs/universe_builder.md); all optional ---
UNIVERSE_CLASSIFY_BATCH=4000
UNIVERSE_MARKET_DATA_BATCH=800
UNIVERSE_MIN_ADV_USD=1000000
UNIVERSE_MIN_PRICE=1.0
UNIVERSE_PRICE_MAX_AGE_DAYS=5
UNIVERSE_ALLOW_UNVERIFIED_SECTOR=false
# Optional, DISABLED by default: a CSV you supply (ticker,sector[,industry]); rows are marked UNVERIFIED
SECTOR_MAPPING_ADAPTER_ENABLED=false
SECTOR_MAPPING_CSV=

# --- Deep-dive data (docs/deep_dive_data.md); all optional ---
# Free keys: finnhub.io and alphavantage.co. Leave blank to keep those adapters off.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_BUDGET=20
# Shortlist for per-company data (analyst ratings, transcripts, XBRL fundamentals, options IV)
DEEP_DIVE_TICKERS=
OPTIONS_IV_ENABLED=false

# Leaders & laggards (docs/leaders_laggards.md); defaults shown
# LEADERS_HISTORY_BATCH=800
# LEADERS_CANDIDATES_PER_SECTOR=8
# LEADERS_MIN_ADV_USD=5000000
# LEADERS_MIN_PRICE=5
# LEADERS_MIN_COMPETITORS=3
# LEADERS_MIN_STRENGTH_GAP=15
# LEADERS_PORTFOLIO_USD=1000000
# LEADERS_GROSS_TARGET_PCT=100
# LEADERS_MAX_LEG_PCT=15

# --- Earnings module (docs/earnings.md); research only ---
# Free keys: finnhub.io/register (FINNHUB_API_KEY) and alphavantage.co/support/#api-key (ALPHA_VANTAGE_API_KEY)
OPTIONS_IV_ENABLED=true
EARNINGS_WATCHLIST=
EARNINGS_MAX_TICKERS=80
EARNINGS_DEEP_TOP_N=12
EARNINGS_MC_PATHS=10000
EARNINGS_BASE_P_UP=0.52
EARNINGS_MIN_ADV_USD=5000000
EARNINGS_LONG_MIN_P_UP=0.58
EARNINGS_LONG_MIN_CONFIDENCE=0.45
EARNINGS_INSIDER_LOOKBACK_DAYS=90
# 13F holders to track: BlackRock, Vanguard, State Street, Berkshire Hathaway
EARNINGS_13F_CIKS=1364742,102909,93751,1067983
# Optional JSON feed of politician trades (House/Senate Stock Watcher style records)
POLITICIAN_TRADES_URL=
# Finnhub congressional trades are a PAID endpoint; leave false on the free tier
FINNHUB_CONGRESS_ENABLED=false
# Extra earnings sources (all free). Nasdaq's calendar is unofficial; set false if it blocks you.
EARNINGS_NASDAQ_ENABLED=true
EARNINGS_FINNHUB_NEWS_ENABLED=true
EARNINGS_8K_LOOKBACK_DAYS=45
